# Expo public env vars (safe to commit). Copy to .env for local use.

# Runtime policy: demo | development | alpha | production
# Mock telemetry and direct mobile MQTT are disabled in alpha/production.
EXPO_PUBLIC_VANTA_MODE=demo

# Realtime device transport
# Alpha/production accept only wss:// URLs without embedded credentials.
EXPO_PUBLIC_DEVICE_WS_URL=

# MQTT bridge (use WebSockets, e.g. ws://<host>:9001)
EXPO_PUBLIC_MQTT_URL=
EXPO_PUBLIC_MQTT_TOPIC_STATE=vantahome/devices/state
EXPO_PUBLIC_MQTT_TOPIC_COMMAND=vantahome/devices/command
EXPO_PUBLIC_MQTT_PUBLISH_STATE=false

# Supabase realtime
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_RT_CHANNEL=device-events

# Sentry crash reporting
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENV=production

# Optional support action shown in Settings.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Camera media endpoints (optional)
# Use your backend to serve per-camera snapshots and live streams.
# Example:
# EXPO_PUBLIC_CAMERA_SNAPSHOT_BASE=https://api.example.com/cameras
# EXPO_PUBLIC_CAMERA_STREAM_BASE=https://stream.example.com/cameras
EXPO_PUBLIC_CAMERA_SNAPSHOT_BASE=
EXPO_PUBLIC_CAMERA_STREAM_BASE=

# Voice OAuth (account linking)
# If omitted, functions URL will be derived from EXPO_PUBLIC_SUPABASE_URL.
EXPO_PUBLIC_VOICE_FUNCTIONS_URL=
EXPO_PUBLIC_VOICE_ALEXA_CLIENT_ID=
EXPO_PUBLIC_VOICE_GOOGLE_CLIENT_ID=

# Ambient temperature sources
# Optional device IDs (from MQTT/WS) that stream tempC updates.
EXPO_PUBLIC_OUTDOOR_SENSOR_ID=
EXPO_PUBLIC_INDOOR_SENSOR_ID=

# Outdoor weather polling (Open-Meteo). Set lat/lon to enable.
EXPO_PUBLIC_WEATHER_LAT=
EXPO_PUBLIC_WEATHER_LON=
EXPO_PUBLIC_WEATHER_POLL_MIN=15
