{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../bridge-dist"
  },
  "include": ["runtime/**/*.ts", "runtime-tests/**/*.ts"]
}
