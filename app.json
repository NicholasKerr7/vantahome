{
  "expo": {
    "name": "vantahome",
    "slug": "vantahome",
    "scheme": "vantahome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow VantaHome to access your photo library to set a profile avatar.",
        "NSMicrophoneUsageDescription": "Allow VantaHome to capture voice commands.",
        "NSSpeechRecognitionUsageDescription": "Allow VantaHome to recognize your voice commands."
      },
      "bundleIdentifier": "com.anonymous.vantahome"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-image-picker",
      "expo-web-browser",
      "expo-notifications",
      "sentry-expo",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ]
    ]
  }
}
