require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
require 'find'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

# React Native's CocoaPods helper shells out to `find` without quoting the project
# path. That breaks when the repo lives in a directory with spaces, which this
# checkout does. Override the global helper here so pod install remains stable
# without editing vendored files in node_modules.
class ::NewArchitectureHelper
  def self.set_RCTNewArchEnabled_in_info_plist(installer, new_arch_enabled)
    project_paths = installer.aggregate_targets
      .map { |target| target.user_project }
      .uniq { |project| project.path }
      .map(&:path)

    excluded_info_plist = ["/Pods", "Tests", "metainternal", ".bundle", "build/", "DerivedData/"]

    project_paths.each do |project_path|
      project_folder_path = File.dirname(project_path)
      info_plist_files = []

      ::Find.find(project_folder_path) do |path|
        next unless File.basename(path) == 'Info.plist'
        next if excluded_info_plist.any? { |excluded| path.include?(excluded) }

        info_plist_files << path
      end

      info_plist_files.each do |info_plist_file|
        info_plist = ::Xcodeproj::Plist.read_from_path(info_plist_file)
        next if info_plist["RCTNewArchEnabled"] == new_arch_enabled

        info_plist["RCTNewArchEnabled"] = new_arch_enabled ? true : false
        ::Xcodeproj::Plist.write_to_path(info_plist, info_plist_file)
      end
    end
  end
end

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
inhibit_all_warnings!

prepare_react_native_project!

target 'vantahome' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'npx',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    minimum_ios_version = podfile_properties['ios.deploymentTarget'] || '15.1'
    suppressed_warning_flags = %w[
      -Wno-nullability-completeness
      -Wno-nonportable-include-path
      -Wno-documentation
      -Wno-documentation-unknown-command
    ]

    replacement_phase_names = {
      'React-Core-prebuilt' => '[RNDeps] Replace React Native Core',
      'ReactNativeDependencies' => '[RNDeps] Replace React Native Dependencies',
      'hermes-engine' => '[Hermes] Replace Hermes',
    }
    exconstants_app_config_phase_name = 'Generate app.config for prebuilt Constants.manifest'
    exconstants_app_config_script = <<~'SCRIPT'
      set -eo pipefail

      DEST="$CONFIGURATION_BUILD_DIR"
      RESOURCE_BUNDLE_NAME="EXConstants.bundle"
      EXPO_CONSTANTS_PACKAGE_DIR="$(cd "$PODS_TARGET_SRCROOT/.." && pwd -P)"

      PROJECT_DIR_BASENAME="$(basename "$PROJECT_DIR")"
      if [ "x$PROJECT_DIR_BASENAME" != "xPods" ]; then
        exit 0
      fi

      PROJECT_ROOT="${PROJECT_ROOT:-$PROJECT_DIR/../..}"
      PROJECT_ROOT="${PROJECT_ROOT:-$EXPO_CONSTANTS_PACKAGE_DIR/../..}"

      cd "$PROJECT_ROOT" || exit

      if [ "$BUNDLE_FORMAT" = "shallow" ]; then
        RESOURCE_DEST="$DEST/$RESOURCE_BUNDLE_NAME"
      elif [ "$BUNDLE_FORMAT" = "deep" ]; then
        RESOURCE_DEST="$DEST/$RESOURCE_BUNDLE_NAME/Contents/Resources"
        mkdir -p "$RESOURCE_DEST"
      else
        echo "Unsupported bundle format: $BUNDLE_FORMAT"
        exit 1
      fi

      "$EXPO_CONSTANTS_PACKAGE_DIR/scripts/with-node.sh" "$EXPO_CONSTANTS_PACKAGE_DIR/scripts/getAppConfig.js" "$PROJECT_ROOT" "$RESOURCE_DEST"
    SCRIPT

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_settings = build_config.build_settings

        build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
        build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
        build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        build_settings['CLANG_WARN_NULLABILITY_COMPLETENESS'] = 'NO'
        build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'

        %w[OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS].each do |setting_name|
          current_flags = Array(build_settings[setting_name] || '$(inherited)')
          suppressed_warning_flags.each do |flag|
            current_flags << flag unless current_flags.include?(flag)
          end
          build_settings[setting_name] = current_flags
        end
      end

      phase_marker = replacement_phase_names[target.name]
      exconstants_target = target.name == 'EXConstants'
      next unless phase_marker || exconstants_target

      target.shell_script_build_phases.each do |phase|
        if phase_marker && phase.name&.include?(phase_marker)
          phase.shell_script = "echo \"Skipping #{phase_marker}; prebuilt #{target.name} artifacts were already prepared during pod install.\""
        end

        next unless exconstants_target
        next unless phase.name&.include?(exconstants_app_config_phase_name)

        phase.shell_script = exconstants_app_config_script
      end
    end
  end

end
