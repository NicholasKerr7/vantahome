{
  "name": "vantahome",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "npm run patch:dependencies && npm run build:scenes",
    "patch:dependencies": "node scripts/patch-query-string.js && node scripts/patch-expo-metro-watchers.js && node scripts/patch-security-dependencies.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:voice-linking": "node scripts/build-voice-linking.js",
    "prepare:voice-linking:cloudflare": "node scripts/prepare-cloudflare-linking.js",
    "preview:voice-linking": "node scripts/preview-voice-linking.js",
    "lint": "tsc --noEmit",
    "lint:edge": "tsc -p supabase/functions/tsconfig.json",
    "verify": "npm run lint && npm run lint:edge && npm run security:dependencies && npm run release:version-check && npm run release:assets-check && npm run release:auth-redirect-check && npm run test:bridge && npm test -- --runInBand && npm run test:home-scene && npm run test:scripts",
    "test:db:remote": "node scripts/run-remote-db-tests.js",
    "supabase:check": "node scripts/check-supabase-readiness.js",
    "security:secrets": "node scripts/check-secrets.js --history",
    "security:dependencies": "node scripts/patch-query-string.js --check && node scripts/patch-expo-metro-watchers.js --check && node scripts/check-dependency-security.js",
    "release:version-check": "node scripts/check-release-version.js",
    "release:assets-check": "node scripts/check-release-assets.js",
    "release:auth-redirect-check": "node scripts/check-auth-redirects.js",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "mqtt:presence": "node scripts/mqtt-presence.js",
    "realtime:server": "node scripts/realtime-server.js",
    "test": "jest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build:bridge": "tsc -p bridge/tsconfig.runtime.json",
    "test:bridge": "npm run build:bridge && node --test bridge-dist/bridge/runtime-tests/*.test.js",
    "build:home-scene": "tsc --project packages/home-scene/tsconfig.json --noEmit && node scripts/build-home-scene.mjs",
    "test:home-scene": "npm test --workspace @vantahome/home-scene",
    "prestart": "npm run build:scenes",
    "preweb": "npm run build:scenes",
    "prebuild": "npm run build:scenes",
    "preandroid": "npm run build:scenes",
    "preios": "npm run build:scenes",
    "eas-build-post-install": "npm run build:scenes",
    "build:filament-materials": "node scripts/build-filament-materials.mjs",
    "build:renderer-lab": "node scripts/build-renderer-lab-assets.mjs && node scripts/build-filament-rain.mjs && node scripts/build-filament-materials.mjs --check && node scripts/build-renderer-lab-web.mjs",
    "build:scenes": "npm run build:home-scene && npm run build:renderer-lab"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lottiefiles/dotlottie-react": "0.13.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.89.0",
    "buffer": "^6.0.3",
    "expo": "~54.0.30",
    "expo-asset": "~12.0.12",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-modules-core": "~3.0.29",
    "expo-notifications": "~0.32.15",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "lottie-react-native": "~7.3.1",
    "mqtt": "^5.14.1",
    "process": "^0.11.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-filament": "1.11.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "1.6.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.9",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.16",
    "pg": "^8.16.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "ws": "^8.18.0"
  },
  "overrides": {
    "@expo/metro": {
      "metro": "0.83.8",
      "metro-babel-transformer": "0.83.8",
      "metro-cache": "0.83.8",
      "metro-cache-key": "0.83.8",
      "metro-config": "0.83.8",
      "metro-core": "0.83.8",
      "metro-file-map": "0.83.8",
      "metro-minify-terser": "0.83.8",
      "metro-resolver": "0.83.8",
      "metro-runtime": "0.83.8",
      "metro-source-map": "0.83.8",
      "metro-symbolicate": "0.83.8",
      "metro-transform-plugins": "0.83.8",
      "metro-transform-worker": "0.83.8"
    },
    "@react-native-voice/voice": {
      "@expo/config-plugins": "54.0.5"
    },
    "postcss": "8.5.26",
    "decode-uri-component": "0.5.0",
    "query-string": "7.1.3",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "workspaces": [
    "packages/home-scene"
  ]
}
